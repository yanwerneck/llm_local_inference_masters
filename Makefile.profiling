# Profiling dedicado. Não use este arquivo na bateria oficial de latência.
ifeq ($(filter oneshell,$(.FEATURES)),)
$(error GNU Make com .ONESHELL necessário; no macOS use gmake atualizado ou execute no pod)
endif
SHELL := /bin/bash
.ONESHELL:
.SHELLFLAGS := -eu -o pipefail -c

ROOT := $(dir $(abspath $(lastword $(MAKEFILE_LIST))))
PYTHON ?= $(ROOT).venv/bin/python
MODEL_SIZE ?= 7B
VLLM_BIN ?= $(shell command -v vllm 2>/dev/null || printf 'vllm')
LLAMA_SERVER_BIN ?= $(shell p=$$(command -v llama-server 2>/dev/null || true); if test -x "$$p"; then printf '%s' "$$p"; else found=; for p in /usr/local/lib/ollama/llama-server /workspace/llama.cpp/build/bin/llama-server /app/llama.cpp/build/bin/llama-server; do if test -x "$$p"; then printf '%s' "$$p"; found=1; break; fi; done; test "$${found:-}" = 1 || printf 'llama-server'; fi)
LLAMA_BACKEND_PATH ?= $(firstword $(wildcard /usr/local/lib/ollama/cuda_v12/libggml-cuda.so /usr/local/lib/ollama/cuda_v13/libggml-cuda.so))
PROFILE_RESULTS_DIR ?= $(ROOT)/results/profiling
STARTUP_TIMEOUT ?= 1800
ifeq ($(MODEL_SIZE),7B)
MODEL_PATH ?= /workspace/models/Qwen2.5-7B-Instruct-Q8_0/Qwen2.5-7B-Instruct-Q8_0.gguf
TOKENIZER_PATH ?= /workspace/models/Qwen2.5-7B-Instruct-original
else ifeq ($(MODEL_SIZE),14B)
MODEL_PATH ?= /workspace/models/Qwen2.5-14B-Instruct-Q8_0.gguf
TOKENIZER_PATH ?= /workspace/models/Qwen2.5-14B-tokenizer
else
$(error MODEL_SIZE deve ser 7B ou 14B)
endif

.PHONY: help check profile-vllm-nsys profile-vllm-ncu profile-llama-nsys profile-llama-ncu

help:
	@echo 'Use em um ambiente separado da bateria oficial:'
	@echo '  make -f Makefile.profiling profile-vllm-nsys MODEL_SIZE=7B'
	@echo '  make -f Makefile.profiling profile-vllm-ncu  MODEL_SIZE=7B'
	@echo '  make -f Makefile.profiling profile-llama-nsys MODEL_SIZE=7B'
	@echo '  make -f Makefile.profiling profile-llama-ncu  MODEL_SIZE=7B'

check:
	@test -x "$(PYTHON)" || { echo "Python ausente: $(PYTHON)"; exit 1; }

profile-vllm-nsys: check
	@command -v nsys >/dev/null || { echo 'nsys ausente'; exit 1; }
	@echo '[PROFILE] vLLM + Nsight Systems; smoke separado da bateria oficial'
	@mkdir -p "$(PROFILE_RESULTS_DIR)"
	stamp=$$(date -u +%Y%m%dT%H%M%SZ); out="$(PROFILE_RESULTS_DIR)/$${stamp}-vllm-nsys"
	mkdir -p "$$out"
	PROFILE_OUTPUT="$${out}/trace" bash "$(ROOT)scripts/nsys-wrapper.sh" \
		"$(VLLM_BIN)" serve "$(MODEL_PATH)" --load-format gguf --quantization gguf --tokenizer "$(TOKENIZER_PATH)" \
		--host 127.0.0.1 --port 8000 --max-model-len 4096 --max-num-seqs 1

profile-vllm-ncu: check
	@command -v ncu >/dev/null || { echo 'ncu ausente'; exit 1; }
	@echo '[PROFILE] vLLM + Nsight Compute; envie uma única requisição curta em outro terminal e interrompa com Ctrl-C.'
	@mkdir -p "$(PROFILE_RESULTS_DIR)"
	stamp=$$(date -u +%Y%m%dT%H%M%SZ); out="$(PROFILE_RESULTS_DIR)/$${stamp}-vllm-ncu"
	mkdir -p "$$out"
	PROFILE_OUTPUT="$${out}/roofline" bash "$(ROOT)scripts/ncu-wrapper.sh" \
		"$(VLLM_BIN)" serve "$(MODEL_PATH)" --load-format gguf --quantization gguf --tokenizer "$(TOKENIZER_PATH)" \
		--host 127.0.0.1 --port 8000 --max-model-len 4096 --max-num-seqs 1

profile-llama-nsys: check
	backend='$(LLAMA_BACKEND_PATH)'; if test -n "$$backend"; then export GGML_BACKEND_PATH="$$backend"; export LD_LIBRARY_PATH="$$(dirname "$$backend"):$${LD_LIBRARY_PATH:-}"; fi
	@command -v nsys >/dev/null || { echo 'nsys ausente'; exit 1; }
	@echo '[PROFILE] llama.cpp + Nsight Systems; use o binário llama-server da imagem.'
	@mkdir -p "$(PROFILE_RESULTS_DIR)"
	stamp=$$(date -u +%Y%m%dT%H%M%SZ); out="$(PROFILE_RESULTS_DIR)/$${stamp}-llama-nsys"
	mkdir -p "$$out"
	PROFILE_OUTPUT="$${out}/trace" bash "$(ROOT)scripts/nsys-wrapper.sh" \
		"$(LLAMA_SERVER_BIN)" -m "$(MODEL_PATH)" \
		--host 127.0.0.1 --port 8080 --ctx-size 4096 --n-gpu-layers 999 --jinja

profile-llama-ncu: check
	backend='$(LLAMA_BACKEND_PATH)'; if test -n "$$backend"; then export GGML_BACKEND_PATH="$$backend"; export LD_LIBRARY_PATH="$$(dirname "$$backend"):$${LD_LIBRARY_PATH:-}"; fi
	@command -v ncu >/dev/null || { echo 'ncu ausente'; exit 1; }
	@echo '[PROFILE] llama.cpp + Nsight Compute; envie uma única requisição curta em outro terminal e interrompa com Ctrl-C.'
	@mkdir -p "$(PROFILE_RESULTS_DIR)"
	stamp=$$(date -u +%Y%m%dT%H%M%SZ); out="$(PROFILE_RESULTS_DIR)/$${stamp}-llama-ncu"
	mkdir -p "$$out"
	PROFILE_OUTPUT="$${out}/roofline" bash "$(ROOT)scripts/ncu-wrapper.sh" \
		"$(LLAMA_SERVER_BIN)" -m "$(MODEL_PATH)" \
		--host 127.0.0.1 --port 8080 --ctx-size 4096 --n-gpu-layers 999 --jinja
